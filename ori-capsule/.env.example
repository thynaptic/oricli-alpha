# ori-capsule local defaults — copy to .env (never commit real keys)
ORI_CAPSULE_PORT=8089
# Optional: require this Bearer to reach the capsule; LLM key then comes from X-API-Key
# ORI_CAPSULE_KEY=
# Default provider when X-Provider is omitted
ORI_DEFAULT_PROVIDER=openai
# Default OpenCode-compatible base (overridable per-request via X-Base-URL)
ORI_OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- Persistence contract ---
# Durable (volume): sessions, spaces, tasks DAG, BM25 RAG under ORI_MEMORY_DIR
ORI_MEMORY_DIR=.memory
# Optional base64 32-byte AES key for the warm bridge (empty → derived from dir, dev only)
# ORI_MEMORY_ENCRYPTION_KEY=
ORI_MEMORY_MAX_TURNS=24
# Ephemeral (process memory): light JIT forge tools — lost on restart
ORI_FORGE_MAX_TOOLS=16
ORI_FORGE_TTL_MIN=30

# GOSH sandbox (mem by default; set ORI_GOSH_WORKSPACE for read-only overlay)
ORI_GOSH_ENABLED=true
# ORI_GOSH_WORKSPACE=/workspace
# ORI_GOSH_FORCE_MEM=true
ORI_GOSH_TIMEOUT_SEC=5
# Docker compose: host path mounted read-only at /workspace
# ORI_GOSH_HOST_PATH=.

# Mount-only overlays (colon-separated dirs; compose defaults shown)
# ORI_SKILLS_DIR=../oricli_core/skills
# ORI_AGENTS_DIR=../.github/agents
# ORI_SKILLS_HOST_PATH=../oricli_core/skills
# ORI_AGENTS_HOST_PATH=../.github/agents

# CORS — empty disables; "*" or comma-separated (e.g. http://localhost:3000)
# ORI_CORS_ORIGINS=

# Local BM25 RAG persists under ORI_MEMORY_DIR/rag. Chat inject: X-Ori-RAG: bm25
# Multipart upload: POST /v1/rag/ingest/file (field "file", optional source/metadata)
